# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

# Dependências
node_modules/
/.pnp
.pnp.js

# Produção / Builds
dist/
dist-ssr/
www/
coverage/
platforms/
plugins/

# Cache e temporários
.tmp
*.tmp
*.tmp.*
.sass-cache/
.sourcemaps/
.versions/
.vite/
.ionic/

# Logs
*.log
log.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variáveis de ambiente e segredos
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Vercel
.vercel

# IDEs e Editores
.idea/
.vscode/*
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*~
*.sw[mnpcod]

# Sistema Operacional
.DS_Store
Thumbs.db
desktop.ini
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

# Playwright & Testes
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
